generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name          String
  username      String  @unique
  email         String  @unique
  emailVerified Boolean
  image         String
  verified      Boolean @default(false)

  statsForNerds Boolean @default(false)
  private       Boolean @default(false)
  streamerMode  Boolean @default(false)
  hideTips      Boolean @default(false)

  bio         String?
  bannerImage String?
  pronoun     String?
  location    String?
  website     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  posts              Post[]
  following          Follow[]       @relation("UserFollowing")
  followers          Follow[]       @relation("UserFollowers")
  likes              Like[]
  comments           Comment[]
  notifications      Notification[] @relation("NotificationUser")
  actorNotifications Notification[] @relation("NotificationActor")
  bookmarks          Bookmark[]
  postViews          PostView[]

  @@map("user")
}

model Post {
  id          String       @id @default(uuid())
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String       @default("")
  flagged     Boolean      @default(false)
  edited      Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  views       Int          @default(1)
  repostOfId  String?
  repostOf    Post?        @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts     Post[]       @relation("PostReposts")
  likes       Like[]
  comments    Comment[]
  attachments Attachment[]
  bookmarks   Bookmark[]
  postViews   PostView[]
  hashtags    PostHashtag[]

  @@index([authorId])
  @@index([repostOfId])
  @@map("post")
}

model PostHashtag {
  postId String
  tag    String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([postId, tag])
  @@index([tag, createdAt])
  @@map("post_hashtag")
}

model Bookmark {
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, postId])
  @@index([postId])
  @@map("bookmark")
}

model PostView {
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_view")
}

model Like {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, postId])
  @@map("like")
}

model Comment {
  id       String @id @default(uuid())
  postId   String
  authorId String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String

  flagged Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("comment")
}

model Attachment {
  id     String @id @default(uuid())
  postId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  name String
  url  String
  type String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([postId])
  @@map("attachment")
}

model Follow {
  userId   String
  followId String

  user   User @relation("UserFollowing", fields: [userId], references: [id], onDelete: Cascade)
  follow User @relation("UserFollowers", fields: [followId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, followId])
  @@map("follow")
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  content String

  read Boolean @default(false)

  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}
