generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Config {
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  name     String
  handle   String @unique
  bio      String?
  email    String
  role     String? @default("Member")
  verified Boolean @default(false)

  emailVerified Boolean @default(false)

  image String?

  privateAccount Boolean @default(false)
  emailNotif     Boolean @default(true)

  website  String?
  location String?

  pronouns    String?
  banner      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions            Session[]
  accounts            Account[]
  posts               Post[]
  likes               Like[]          @relation("UserLikes")
  bookmarks           Bookmark[]
  postViews           PostView[]
  following           Follow[]        @relation("UserFollowing")
  followers           Follow[]        @relation("UserFollowers")
  notifications       Notification[]
  dmParticipants      DMParticipant[]
  dmMessages          DMMessage[]     @relation("DMSender")
  warmFuzziesSent     WarmFuzzy[]     @relation("WarmFuzzySender")
  warmFuzziesReceived WarmFuzzy[]     @relation("WarmFuzzyRecipient")
  pollVotes           PollVote[]

  @@unique([email])
}

model Post {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // "post" | "reply" | "repost" | "quote"
  type String @default("post")

  // Self-referencing: replies point to their parent, reposts/quotes point to the original
  parentId String?
  parent   Post?   @relation("PostChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Post[]  @relation("PostChildren")

  content     String @default("")
  attachments Json?
  poll        Json?
  editedAt    DateTime?

  viewCount Int @default(0)

  readOnly Boolean @default(false)
  pinned   Boolean @default(false)

  isHidden  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes      Like[]        @relation("PostLikes")
  bookmarks  Bookmark[]
  views      PostView[]
  hashtags   PostHashtag[]
  pollVotes  PollVote[]

  @@index([authorId])
  @@index([createdAt])
  @@index([parentId])
  @@index([type])
}

model PollVote {
  userId      String
  postId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Hashtag {
  id   String @id @default(cuid())
  tag  String @unique

  posts PostHashtag[]

  @@index([tag])
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

model PostView {
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([postId])
}

model Like {
  userId String
  postId String
  user   User   @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Bookmark {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
  @@index([createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  actorId   String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  message   String

  actor User @relation(fields: [actorId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model DMConversation {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  participants DMParticipant[]
  messages     DMMessage[]

  @@index([lastMessageAt])
  @@index([createdAt])
}

model DMParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([joinedAt])
}

model DMMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deleted        Boolean  @default(false)

  conversation DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model WarmFuzzy {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String
  isReported  Boolean  @default(false)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User @relation("WarmFuzzySender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("WarmFuzzyRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  handle      String
  displayName String
  token       String    @unique
  used        Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String

  @@index([email])
  @@index([token])
  @@index([createdAt])
}
